# Copy thành .env (cùng thư mục với docker-compose.yml) rồi sửa giá trị.

# --- PostgreSQL 17 ---
POSTGRES_USER=play4fun
# Chỉ dùng chữ/số/-/_ để không phải URL-encode trong DATABASE_URL
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=play4fun

# --- Domain công khai (dùng cho CORS của realtime, link share, OG image) ---
PUBLIC_URL=https://play4fun.io.vn

# --- Cổng bind trên 127.0.0.1 của server, nginx native sẽ proxy vào ---
WEB_PORT=3000
REALTIME_PORT=3001
# Postgres chỉ mở trên localhost để bạn quản trị qua SSH tunnel
POSTGRES_PORT=5432

# --- Đăng nhập (không bắt buộc với người chơi; xem mục "Đăng nhập" trong README) ---
# Chuỗi ngẫu nhiên ≥ 32 ký tự, tạo bằng:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Cloud Console → OAuth client (Web). Redirect URI: ${PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → Facebook Login. Redirect URI: ${PUBLIC_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Thống kê truy cập (Umami) + trang /admin (xem mục "Thống kê & trang admin" trong README) ---
# Chuỗi ngẫu nhiên cho Umami:  openssl rand -base64 32
UMAMI_APP_SECRET=
# Id website tạo trong dashboard Umami (để trống = chưa bật thống kê)
UMAMI_WEBSITE_ID=
# Email (cách nhau bởi dấu phẩy) được vào trang /admin sau khi đăng nhập
ADMIN_EMAILS=

# --- Quảng cáo Google AdSense (để trống = tắt; xem README) ---
# Mã nhà xuất bản dạng ca-pub-1234567890123456
ADSENSE_CLIENT=
# Id 2 đơn vị quảng cáo (Ads → By ad unit → Display ads): trang chủ và cột bên trang game/thử thách/xếp hạng
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_SIDEBAR=
