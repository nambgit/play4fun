# Copy thành .env (cùng thư mục với docker-compose.yml) rồi sửa giá trị.

# --- PostgreSQL 17 ---
POSTGRES_USER=play4fun
# Chỉ dùng chữ/số/-/_ để không phải URL-encode trong DATABASE_URL
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=play4fun

# --- Domain công khai (dùng cho CORS của realtime, link share, OG image) ---
PUBLIC_URL=https://play4fun.io.vn

# --- Cổng bind trên 127.0.0.1 của server, nginx native sẽ proxy vào ---
WEB_PORT=3000
REALTIME_PORT=3001
# Postgres chỉ mở trên localhost để bạn quản trị qua SSH tunnel
POSTGRES_PORT=5432
